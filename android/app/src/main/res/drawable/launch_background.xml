<?xml version="1.0" encoding="utf-8"?>
<!-- Pacta 冷启动首帧：柔和浅色底 + 居中品牌图标，和 values/styles.xml 的
     LaunchTheme 配合，消除引擎首帧前的纯白闪跳。首帧之后的品牌过渡由
     lib/src/app/pacta_splash_gate.dart 接管（#F8FAFC 与主题 surface 同源）。
     与 drawable-v21/launch_background.xml 保持一致：API 21+ 会优先解析那份，
     两份只在注释措辞上不同。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F8FAFC" />
        </shape>
    </item>
    <item
        android:drawable="@mipmap/ic_launcher"
        android:gravity="center"
        android:width="108dp"
        android:height="108dp" />
</layer-list>
