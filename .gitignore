# Miscellaneous
# Local configuration; only sanitized templates belong in Git.
.env
.env.*
!.env.example
!.env.*.example

*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Local editor settings may contain machine-specific paths.
.vscode/

# Temporary screenshots, databases, and publication drafts.
.scratch/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# MiSans originals are fetched from Xiaomi; do not mirror standalone fonts.
/assets/fonts/MiSans-*.ttf
/android/build/
/coverage/
node_modules/
supabase/.branches/
supabase/.temp/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local-only AI development docs and agent entry points.
# These stay on the developer machine and are never published: the docs tree,
# shared agent guides, glossary, mission brief and local agent configuration.
# Nested AGENTS.md/CLAUDE.md and their variants are matched without a root anchor.
/docs/
AGENTS.md
AGENTS.override.md
CLAUDE.md
CLAUDE.local.md
/GLOSSARY.md
/MISSION.md
.agents/
.agent/
.codex/
.claude/
.cursor/
